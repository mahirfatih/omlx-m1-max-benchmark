{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "oMLX settings (sanitized example)",
  "type": "object",
  "required": ["version", "server", "model", "memory", "scheduler", "auth"],
  "properties": {
    "version": { "type": "string" },
    "server": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "description": "Keep 127.0.0.1; do not expose the server." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "model": {
      "type": "object",
      "required": ["model_dirs"],
      "properties": {
        "model_dirs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "prefill_memory_guard": { "type": "boolean" },
        "memory_guard_tier": { "type": "string", "enum": ["conservative", "balanced", "aggressive"] },
        "soft_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "hard_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "max_concurrent_requests": { "type": "integer", "minimum": 1 },
        "chunked_prefill": { "type": "boolean" }
      }
    },
    "auth": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "description": "Placeholder in the example; never commit the real key." }
      }
    },
    "sampling": { "type": "object" },
    "idle_timeout": {
      "type": "object",
      "properties": { "idle_timeout_seconds": { "type": "integer", "minimum": 0 } }
    }
  }
}