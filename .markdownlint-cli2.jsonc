{
  // markdownlint-cli2 configuration for this repository.
  //
  // Seven rules are off on purpose, and each is a deliberate writing choice
  // rather than an accident:
  //
  //   MD013 (line-length)         the documents wrap by paragraph; breaking a
  //                               table row to fit 80 columns makes it unreadable.
  //   MD033 (no-inline-html)      a few documents keep two values in one cell
  //                               with <br>.
  //   MD060 (table-column-style)  the tables are aligned for the source, not for
  //                               one fixed pipe style.
  //   MD028 (no-blanks-blockquote) the source-quote pairs in README.md and
  //                               MODELS.md separate the quote from its
  //                               attribution with a blank quote line on purpose.
  //   MD036 (no-emphasis-as-heading) README.md uses a bold "Summary" / "Model →
  //                               profile" line as a label, not as a heading.
  //   MD009 (trailing spaces)     generated `evidence/` pages quote raw model
  //   MD032 (blanks-around-lists) answers verbatim, including their own trailing
  //                               spaces and list spacing; the raw bytes matter.
  //
  // MD024 stays on, but siblings only: CHANGELOG.md repeats `### Added` once per
  // release, which is the correct Keep a Changelog shape.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD060": false,
    "MD028": false,
    "MD036": false,
    "MD009": false,
    "MD032": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/__pycache__/**",
    ".venv*/**",
    "benchmarks/**"
  ]
}
